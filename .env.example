# LLM: gemini | openai | anthropic | mock (mock = offline, no API key needed)
LLM_PROVIDER=mock
LLM_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: hashing (offline) | sentence-transformers | openai | gemini
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=

# Market data: auto | alphavantage | yfinance | sample
MARKET_DATA_PROVIDER=auto
ALPHA_VANTAGE_API_KEY=

# Voice input (used whenever OPENAI_API_KEY is set)
TRANSCRIBE_MODEL=whisper-1
